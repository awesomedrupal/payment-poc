# API
PORT=3000
DATABASE_URL=postgres://pay:pay@localhost:5432/paydb
KAFKA_BROKERS=localhost:9092
PAYMENTS_TOPIC=payments.events

# Merchant HMAC
NONCE_TTL_SECONDS=600
HMAC_SKEW_SECONDS=300

# Webhook verification (processor -> you)
PROCESSOR_WEBHOOK_SECRET=processor_webhook_secret_dev

# Orchestrator / processor wiring
FAKE_PROCESSOR_URL=http://localhost:4000
SERVICE_BASE_URL=http://localhost:3000
WEBHOOK_TARGET_URL=http://localhost:3000/webhooks/gateway
DEFAULT_OUTCOME=succeed

# Outbox publisher
OUTBOX_POLL_MS=250
OUTBOX_BATCH_SIZE=200

# Reconciler
RECONCILE_EVERY_MS=5000
